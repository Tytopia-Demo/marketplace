# =============================================================================
# UNIFIED LOGGING FRAMEWORK CONFIGURATION
# =============================================================================
# This file contains example configuration for the unified logging framework.
# Copy these settings to your .env file and adjust as needed.
# =============================================================================

# -----------------------------------------------------------------------------
# Basic Logging Configuration
# -----------------------------------------------------------------------------

# Default log channel - use 'json_daily' for production with structured logs
LOG_CHANNEL=stack

# Log level - debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=debug

# Stack channels - comma-separated list of channels to use
# For production with JSON: LOG_STACK=daily,json_daily
LOG_STACK=single

# Deprecations logging
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

# Daily log rotation - number of days to keep logs
LOG_DAILY_DAYS=14

# -----------------------------------------------------------------------------
# Production Logging Configuration (Recommended)
# -----------------------------------------------------------------------------
# Uncomment these for production environments:
#
# LOG_CHANNEL=json_daily
# LOG_LEVEL=info
# LOG_STACK=daily,json_daily
# LOG_DAILY_DAYS=30

# -----------------------------------------------------------------------------
# Telemetry Configuration
# -----------------------------------------------------------------------------

# Enable/disable telemetry context in logs
TELEMETRY_ENABLED=true

# Include user ID in telemetry context
TELEMETRY_INCLUDE_USER=true

# Include session ID in telemetry context
TELEMETRY_INCLUDE_SESSION=true

# Telemetry sampling rate (0-100) - use 100 for all requests
# Lower values reduce log volume in high-traffic scenarios
TELEMETRY_SAMPLING_RATE=100

# HTTP headers for distributed tracing
TELEMETRY_REQUEST_ID_HEADER=X-Request-ID
TELEMETRY_TRACE_ID_HEADER=X-Trace-ID

# Channels that should have telemetry context added
# Comma-separated list of channel names
LOG_TELEMETRY_CHANNELS=single,daily,stack,json,json_daily

# -----------------------------------------------------------------------------
# Application Metadata (included in all logs)
# -----------------------------------------------------------------------------

# Application version - will be included in service metadata
APP_VERSION=1.0.0

# Application name - defaults to 'marketplace'
APP_NAME=marketplace

# Environment name - development, staging, production
APP_ENV=local

# -----------------------------------------------------------------------------
# Third-Party Logging Services
# -----------------------------------------------------------------------------

# Slack logging (for critical errors)
# LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# LOG_SLACK_USERNAME="Laravel Log"
# LOG_SLACK_EMOJI=":boom:"

# Papertrail logging (for centralized log aggregation)
# PAPERTRAIL_URL=logs.papertrailapp.com
# PAPERTRAIL_PORT=12345
# LOG_PAPERTRAIL_HANDLER=Monolog\Handler\SyslogUdpHandler

# Sentry error tracking
# SENTRY_LARAVEL_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# -----------------------------------------------------------------------------
# Performance and Advanced Settings
# -----------------------------------------------------------------------------

# Maximum log file size (for single channel)
# LOG_MAX_FILE_SIZE=10485760  # 10MB

# Async logging (reduces performance impact)
# LOG_ASYNC=true

# Buffer size for async logging
# LOG_BUFFER_SIZE=100

# -----------------------------------------------------------------------------
# Environment-Specific Examples
# -----------------------------------------------------------------------------

# LOCAL DEVELOPMENT
# ------------------
# LOG_CHANNEL=stack
# LOG_STACK=single
# LOG_LEVEL=debug
# TELEMETRY_ENABLED=true
# TELEMETRY_SAMPLING_RATE=100

# STAGING
# -------
# LOG_CHANNEL=json_daily
# LOG_LEVEL=debug
# TELEMETRY_ENABLED=true
# TELEMETRY_SAMPLING_RATE=100
# LOG_DAILY_DAYS=14

# PRODUCTION
# ----------
# LOG_CHANNEL=json_daily
# LOG_LEVEL=info
# TELEMETRY_ENABLED=true
# TELEMETRY_SAMPLING_RATE=50  # Sample 50% for high-traffic apps
# LOG_DAILY_DAYS=30
# LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# HIGH-TRAFFIC PRODUCTION (with sampling)
# ----------------------------------------
# LOG_CHANNEL=json_daily
# LOG_LEVEL=warning  # Only log warnings and above
# TELEMETRY_ENABLED=true
# TELEMETRY_SAMPLING_RATE=10  # Sample 10% to reduce log volume
# LOG_DAILY_DAYS=7
# LOG_STACK=json_daily,slack  # Also send critical errors to Slack

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Request IDs are automatically generated for all HTTP requests
# 2. Queue jobs preserve the request ID from the originating request
# 3. Console commands get unique request IDs
# 4. All logs include telemetry context when enabled
# 5. JSON logs are optimized for parsing by log aggregation tools
# 6. Use LOG_STACK to write to multiple channels simultaneously
# 7. Consider using LOG_CHANNEL=json_daily for production environments
# 8. Adjust TELEMETRY_SAMPLING_RATE for high-traffic applications
#
# For more information, see LOGGING.md
# =============================================================================
